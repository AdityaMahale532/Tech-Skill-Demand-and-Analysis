7. Final Dataset Preparation
import pandas as pd

df = pd.read_csv('/content/sample_data/dataset_naukri-job-scraper_2026-06-15_05-10-44-119.csv')

# Skills columns collect karo
skill_cols = [f'jobDetails/keySkills/other/{i}/label' for i in range(10)] + \
             ['jobDetails/keySkills/preferred/0/label']

# Final clean dataframe
df_final = pd.DataFrame({ 
    'Job Title':        df['jobDetails/title'],
    'Company':          df['jobDetails/companyDetail/name'],
    'Location':         df['jobDetails/locations/0/label'],
    'Experience':       df['jobDetails/experienceText'],
    'Min Experience':   df['jobDetails/minimumExperience'],
    'Max Experience':   df['jobDetails/maximumExperience'],
    'Salary Label':     df['jobDetails/salaryDetail/label'],
    'Min Salary (INR)': df['jobDetails/salaryDetail/minimumSalary'],
    'Max Salary (INR)': df['jobDetails/salaryDetail/maximumSalary'],
    'Job Role':         df['jobDetails/jobRole'],
    'Skills':           df[skill_cols].apply(
        lambda row: ', '.join(row.dropna().astype(str)), axis=1
    ),
})

# NaN rows drop karo
df_final = df_final.dropna(
    subset=['Job Title', 'Company']
).reset_index(drop=True)

print(f"✅ Final dataset: {df_final.shape}")
print(df_final.head())
8. Save Final Clean Dataset
df_final.to_csv(
    '/content/sample_data/final_clean_naukri.csv',
    index=False
)

print("\n✅ Saved: final_clean_naukri.csv")
