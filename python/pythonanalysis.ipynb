2. Initial Data Cleaning
df_clean = df.dropna(axis=1, thresh=int(0.3 * len(df)))

# Step 2: Keep only useful job-related columns
job_cols = [col for col in df_clean.columns if any(keyword in col.lower() 
            for keyword in ['title', 'salary', 'skill', 'company', 
                           'experience', 'location', 'city', 'role', 'tag'])]

df_final = df_clean[job_cols]

# Step 3: Drop duplicate rows
df_final = df_final.drop_duplicates()

# Step 4: Reset index
df_final = df_final.reset_index(drop=True)

print(f"Clean dataset: {df_final.shape}")
print(f"\nColumns: {df_final.columns.tolist()}")

# Step 5: Save clean CSV
df_final.to_csv('/content/sample_data/clean_data_analyst.csv', index=False)

print("\n✅ Clean CSV saved!")

df_final.head()
